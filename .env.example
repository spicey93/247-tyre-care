# Supabase: Settings → Database → Connection string (use pooler for serverless if you use it in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-random-secret"

# Public URL of the app (e.g. https://your-domain.com) — used by Auth.js in production
AUTH_URL="http://localhost:3000"

# Optional: seed creates/updates this admin login (defaults in prisma/seed.ts if unset)
# INITIAL_OWNER_EMAIL="you@yourdomain.com"
# INITIAL_OWNER_PASSWORD="use-a-strong-password"
